msgstr "بله، بازنشانی کن"

#: includes/Admin/Admin.php:208
msgid "Cancel"
msgstr "انصراف"

#: includes/Admin/Admin.php:209
msgid "You have unsaved changes. Leave anyway?"
msgstr "تغییرات ذخیره‌نشده دارید. با این حال خارج می‌شوید؟"

#: includes/Admin/Admin.php:210
msgid "Feature enabled."
msgstr "امکان فعال شد."

#: includes/Admin/Admin.php:211
