#. Plugin Name of the plugin
#: lenz-plus.php includes/Admin/Admin.php:57 includes/Admin/Admin.php:68
#: includes/Admin/views/layout.php:23
msgid "Lenz Plus"
msgstr "لنز پلاس"

#. Description of the plugin
#: lenz-plus.php
msgid "Extra features for the Lenz photography theme: a customizable mobile bottom navigation, a floating support button, and Elementor page templates for the home, about, services, portfolio, courses and blog pages with their header and footer."
msgstr "امکانات تکمیلی قالب عکاسی لنز: منوی پایین موبایل قابل‌شخصی‌سازی، دکمهٔ پشتیبانی شناور و قالب‌های المنتور برای صفحهٔ اصلی، درباره، خدمات، نمونه‌کارها، دوره‌ها و بلاگ به‌همراه هدر و فوتر."

#. Author of the plugin
#: lenz-plus.php
msgid "Hooman Jamshidi"
msgstr "هومن جمشیدی"

